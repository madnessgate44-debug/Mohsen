# Firstborn / Forge configuration surface
# Copy to .env and fill only what you need. Never commit real secrets.

# --- Model providers (all optional) ---
# Keyless freelm routes are the primary path. These keys enable stronger models.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# FIRSTBORN_KEYLESS_ONLY=true   # force keyless-only; disables Gemini fallback

# --- GitHub ---
# GITHUB_TOKEN=                 # required for commits/PRs and authenticated API
# FORGE_ALLOWED_REPOS=madnessgate44-debug/Firstborn
# FORGE_ALLOWED_LOGINS=madnessgate44-debug
# FORGE_DELIVER_TOKEN=          # PAT with repo scope for cross-repo delivery

# --- Permission profile (least privilege by default) ---
# FORGE_PERMISSION_PROFILE=review   # readonly | sandbox | review | publish
# FORGE_REQUIRE_HUMAN_APPROVAL=true
# FORGE_ALLOWED_BRANCH_PREFIX=forge/task-
# FORGE_FORBIDDEN_BRANCHES=main,master

# --- Server ---
# PORT=3000

# --- Company / audit ---
# FORGE_COMPANY_ATTEMPTS=2
# FORGE_AUDIT_ATTEMPTS=2
# FORGE_TARGET_REPO=owner/repo   # for scripts/audit.ts and audit-runner
